# Se activează rescrierea adreselor.
RewriteEngine On

# Se dezactivează potrivirea automată a extensiilor.
Options -MultiViews

# /lucrari afișează intern fișierul lucrari.html.
RewriteRule ^lucrari/?$ lucrari.html [END,NC]

# Se blochează accesul public la folderele sensibile.
RewriteRule ^(?:config|database|scripts)(?:/|$) - [F,END,NC]

# Se blochează fișierele SQL.
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>